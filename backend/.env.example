# ═══════════════════════════════════════════════════════════════
# Variables de Entorno — Backend ISTQB Study Agent
# ═══════════════════════════════════════════════════════════════
# Copia este archivo como .env y reemplaza los valores.
# NO subas el archivo .env al repositorio.
# ═══════════════════════════════════════════════════════════════

# --- Metadatos de la Aplicación ---
PROJECT_NAME=ISTQB Study Agent API
VERSION=0.1.0
DEBUG=false

# --- Servidor ---
HOST=0.0.0.0
PORT=8000

# --- Frontera privada Next.js BFF → FastAPI ---
# Usa el mismo secreto aleatorio de al menos 32 caracteres en ambos servicios.
BFF_SHARED_SECRET=replace-with-a-random-secret-of-at-least-32-characters
MAX_UPLOAD_BYTES=20971520
MULTIPART_OVERHEAD_BYTES=262144
PDF_RATE_LIMIT_REQUESTS=5
PDF_RATE_LIMIT_WINDOW_SECONDS=60
# JSON. Mantener [] mientras el navegador solo llame al BFF de Next.js.
CORS_ORIGINS=[]

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
